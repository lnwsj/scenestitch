[Unit]
Description=SceneStitch - video stitch + subtitle burner (110.164.146.205)
After=network.target
Wants=network.target

[Service]
Type=simple
User=sj88backup02
Group=sj88backup02
WorkingDirectory=/opt/scenestitch
Environment="PATH=/opt/scenestitch/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="SCENESTITCH_FFMPEG=/opt/ffmpeg-cuda-v6/bin/ffmpeg"
Environment="SCENESTITCH_FFMPEG_BURN=/usr/bin/ffmpeg"
Environment="SCENESTITCH_WHISPER_DEVICE=auto"
Environment="SCENESTITCH_WHISPER_COMPUTE=auto"
Environment="SCENESTITCH_UPLOAD_DIR=/opt/scenestitch/data/uploads"
Environment="SCENESTITCH_JOB_DIR=/opt/scenestitch/data/jobs"
Environment="SCENESTITCH_OUTPUT_DIR=/opt/scenestitch/data/outputs"
Environment="SCENESTITCH_MAX_UPLOAD_MB=2048"
Environment="SCENESTITCH_MAX_CONCURRENT=1"
ExecStart=/opt/scenestitch/venv/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 38768 --log-level info
Restart=always
RestartSec=5
StandardOutput=append:/var/log/scenestitch-app.log
StandardError=append:/var/log/scenestitch-app.log

[Install]
WantedBy=multi-user.target
